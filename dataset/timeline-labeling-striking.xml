  >
    <Label value="background" background="#a2a2a2"/>
    <Label value="punch" background="#0000ff"/>
    <Label value="elbow" background="#8996f5"/>
    <Label value="kick" background="#9d00ff"/>
    <Label value="knee" background="#e078fc"/>
